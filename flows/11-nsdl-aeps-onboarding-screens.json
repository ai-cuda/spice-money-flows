 {
  "id": "ko-details",
  "path": "ko",
  "screen_class": "spice.mudra.nsdlekyc.ko.view.NSDLeKYCVerification (step 1)",
  "layout": "activity_nsdl_ekycverification (+ layout_nsdl_stepper, layout_nsdl_ekyc_benefit, toolbar_spice_white, loading_state)",
  "title": "NSDL eKYC",
  "texts": [
   "NSDL eKYC",
   "1",
   "Detail Verification",
   "2",
   "Aadhaar Verification",
   "<server name>",
   "Adhikari ID: <clientId>",
   "Mobile Number",
   "<mbNo>",
   "Trying to auto read OTP (hidden)",
   "Verify",
   "Verified",
   "PAN Number",
   "<panNo, decrypted if encryptPanFlag=Y>",
   "Verify",
   "Verified",
   "Shop Address",
   "<shopAddr>",
   "Confirm",
   "Confirmed",
   "Proceed to Aadhaar Verification",
   "BENEFITS OF eKYC",
   "<iconDtls[0..2].text from server>",
   "Powered by",
   "Help"
  ],
  "fields": [],
  "buttons": [
   "Verify (mobile)",
   "Verify (PAN; enabled after mobile verified)",
   "Confirm (address; enabled after PAN verified)",
   "Proceed to Aadhaar Verification (enabled after address confirmed)",
   "Help",
   "back",
   "bot FAB (aepsBot == Y)"
  ],
  "api": [
   {
    "method": "POST",
    "path": "https://nsdlekyc.spicemoney.com/nsdlkosubko/ws/init/v1",
    "request_fields": [
     "common body (CommonUtility.Y) + clientId; headers mode=APP, lang, token, clientId, bcAgentId"
    ],
    "response_fields_used": [
     "rs (S/SU ok; F/FL/EX01 block)",
     "rc (099 logout)",
     "rd",
     "payload.requestId",
     "payload.pidDtls",
     "payload.deviceListV2",
     "payload.cryptoKey",
     "payload.encryptPanFlag",
     "payload.mbNo",
     "payload.panNo",
     "payload.shopAddr",
     "payload.name",
     "payload.clientId",
     "payload.dob",
     "payload.selfie",
     "payload.contactDetails[]",
     "payload.iconDtls[]",
     "payload.step",
     "payload.aadharConcent"
    ]
   },
   {
    "method": "POST",
    "path": "https://nsdlekyc.spicemoney.com/nsdlkosubko/ws/otpinit/v1",
    "request_fields": [
     "mbNo",
     "requestId"
    ],
    "response_fields_used": [
     "rs",
     "rd",
     "payload.otprequestId"
    ]
   },
   {
    "method": "POST",
    "path": "https://nsdlekyc.spicemoney.com/nsdlkosubko/ws/pan/validate/v1",
    "request_fields": [
     "panNumber (AES if encryptPanFlag=Y)",
     "step=2",
     "name",
     "dob",
     "requestId"
    ],
    "response_fields_used": [
     "rs",
     "rd"
    ]
   },
   {
    "method": "POST",
    "path": "https://nsdlekyc.spicemoney.com/nsdlkosubko/ws/addr/confirm/v1",
    "request_fields": [
     "address",
     "step=3",
     "requestId"
    ],
    "response_fields_used": [
     "rs",
     "rd"
    ]
   }
  ],
  "next": [
   {
    "to": "ko-init-blocked",
    "condition": "init rs in F / FL / EX01"
   },
   {
    "to": "ko-otp-sheet",
    "condition": "Verify (mobile) and otpinit rs S/SU"
   },
   {
    "to": "ko-aadhaar",
    "condition": "Proceed to Aadhaar Verification"
   },
   {
    "to": "help-sheet",
    "condition": "Help"
   },
   {
    "to": "caller (RESULT_OK + serviceName)",
    "condition": "back when skipFlag != Y"
   },
   {
    "to": "caller (plain back)",
    "condition": "back when skipFlag == Y"
   }
  ],
  "notes": "Mobile, PAN and address are read-only TextViews filled from init; the agent cannot edit them. payload.step resumes: 1 = mobile verified, 2 = + PAN verified, 3 = + address confirmed (Proceed enabled). Failures show a toast with responseDesc and bring the button back. All verify buttons start disabled (alpha 0.6); Verify (mobile) is enabled on init success."
 },
