[
 {
  "id": "entry-aeps-tile-gate",
  "path": "entry",
  "screen_class": "ServiceActionHandler.hitNSDLEkycMandatePOPUp (no UI of its own)",
  "layout": "—",
  "title": "",
  "texts": [],
  "fields": [],
  "buttons": [],
  "api": [],
  "next": [
   {
    "to": "ekyc-hub",
    "condition": "AePS tile AEPS_CW/BE/CD/MINI/STLM; O0()=='NA'; YBL mandate (C1) not Y; EKYC_MANDATE_NSDL field1 == Y. Extras: mode=field3, autoTrigger=true, skipFlag=N, serviceName=<tile> unless field2 == Y"
   },
   {
    "to": "aeps (flow 03)",
    "condition": "EKYC_MANDATE_NSDL field1 != Y"
   }
  ],
  "notes": "HomeINIT key 'NSDLekycMandatepopup' -> pref EKYC_MANDATE_NSDL = 'Y|<resume>|<mode>'. If the pref has no '|', B1() returns (true,true) but the popup method does nothing, so the tile tap is a silent no-op."
 },
 {
  "id": "ekyc-hub",
  "path": "entry",
  "screen_class": "spice.mudra.yblekyc.activity.EKYCModuleActivity",
  "layout": "ekyc_module_activity + ekyc_module_item",
  "title": "Do eKYC",
  "texts": [
   "Do eKYC",
   "Do your eKYC on respective banks and start using Spice Money services",
   "<per module: moduleName, moduleSubTitle, moduleImage; green tick when moduleStatus=C>"
  ],
  "fields": [],
  "buttons": [
   "<module row: NSDL>",
   "back",
   "bot FAB (when enabled)"
  ],
  "api": [
   {
    "method": "POST",
    "path": "https://dmt.spicemoney.com/scommyblekyc/ws/agent/homeInit/v1",
    "request_fields": [
     "reqFor=DASHBOARD"
    ],
    "response_fields_used": [
     "dashboardDtls[].moduleCode",
     "moduleName",
     "moduleSubTitle",
     "moduleImage",
     "moduleStatus",
     "moduleAccessibility",
     "moduleMessage",
     "configFlags.updateAgentDet",
     "footerData"
    ]
   }
  ],
  "next": [
   {
    "to": "ko-details",
    "condition": "autoTrigger && mode == NSDL (opened for result, extras serviceName + skipFlag)"
   },
   {
    "to": "ko-details",
    "condition": "tap NSDL row and moduleAccessibility == Y"
   },
   {
    "to": "toast/alert moduleMessage",
    "condition": "tap NSDL row and moduleAccessibility != Y"
   }
  ],
  "notes": "Also reached by deep link 'ekycAll'. The same module list appears under Account settings -> KYC status (AccountSettingActivity). On RESULT_OK from the KO screen the hub finishes and passes serviceName back to the AePS caller."
 },
