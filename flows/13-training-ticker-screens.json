      "Join training at 3pm (popupTitle)",
      "Training 3 baje shuru hogi. Kripya 3 baje yahan click karein. (popupSubTitle)"
    ],
    "fields": [],
    "buttons": [
      "Okay"
    ],
    "api": [],
    "next": [
      {
        "to": "home-ticker",
        "condition": "Okay"
      }
    ],
    "notes": "Title gradient #293895 → #E12427."
  },
  {
    "id": "external-link",
    "path": "Dashboard > ticker Live > Join Now",
